{
  "name": "cedar-test-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright/TypeScript test framework (runs alongside the Python tools)",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "typecheck": "tsc --noEmit",
    "flaky": "tsx scripts/analyze-flaky-tests.ts results/",
    "report": "playwright show-report",
    "test:cedar": "playwright test --project=cedar"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "fast-xml-parser": "^5.11.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  }
}
