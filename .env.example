# Copy to .env for local runs: cp .env.example .env
# .env is git-ignored. Shell and CI variables take precedence over this file.

# Target environment from config/environments.ts: local | staging | prod
TEST_ENV=local

# Optional overrides for the URLs in config/environments.ts.
# Setting BASE_URL also enables the e2e smoke test.
# BASE_URL=http://localhost:3000
# API_URL=http://localhost:8080

# Bearer token sent by the api fixture. Never commit a real token.
# API_TOKEN=
