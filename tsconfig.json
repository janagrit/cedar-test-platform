{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@src/*": ["./src/*"],
      "@config/*": ["./config/*"]
    }
  },
  "include": ["src", "tests", "config", "scripts", "playwright.config.ts"]
}
